{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "noEmit": true,

    "types": ["node", "@playwright/test"]
  },
  "include": [
    "config/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}